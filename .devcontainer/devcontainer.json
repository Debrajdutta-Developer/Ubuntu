{
  "name": "Ubuntu 24.04 XFCE + Antigravity Desktop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/Ubuntu",
  "containerEnv": {
    "HOME": "/workspaces/.cloud-home",
    "DISPLAY": ":1"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Ubuntu XFCE Desktop (noVNC)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "remoteUser": "codespace",
  "overrideCommand": false,
  "shutdownAction": "stopContainer",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ]
    }
  }
}

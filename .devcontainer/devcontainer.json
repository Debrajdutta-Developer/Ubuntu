{
  "name": "Kali Linux Full GUI Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/Ubuntu",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Kali Linux GUI Launcher",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "remoteUser": "root",
  "overrideCommand": false,
  "shutdownAction": "stopContainer",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ]
    }
  }
}
